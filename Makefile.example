# Claude Code skill dependencies
# Copy this to your project's Makefile (or include it in an existing one).
#
# Usage:
#   make install-claude-deps    # Install all Claude skills + tools
#   make update-claude-deps     # Update all to latest

# --- Skills registry ---
# Add skills here as: REPO@SKILL_DIR (the dir inside the repo containing SKILL.md)
CLAUDE_SKILLS := \
	kzarzycki/agent-skills@flow

# --- Config ---
SKILLS_DIR := .claude/skills
TMP_BASE := /tmp/claude-skill

# --- Targets ---
.PHONY: install-claude-deps update-claude-deps clean-claude-deps check-npx-skills

install-claude-deps: check-npx-skills $(foreach s,$(CLAUDE_SKILLS),$(SKILLS_DIR)/$(lastword $(subst @, ,$(s)))/SKILL.md)

check-npx-skills:
	@command -v npx >/dev/null 2>&1 || { echo "npx not found. Install Node.js: https://nodejs.org"; exit 1; }
	@npx skills --version >/dev/null 2>&1 || echo "Note: 'npx skills' will be available on first use (auto-downloads)."

# Pattern: install a skill from REPO@SKILL_DIR
define install_skill
$(SKILLS_DIR)/$(2)/SKILL.md:
	@echo "Installing skill: $(2) from $(1)..."
	@mkdir -p $(SKILLS_DIR)/$(2)
	@TMP=$(TMP_BASE)-$(2)-$$$$$$$$ && \
		git clone --depth 1 https://github.com/$(1).git $$$$TMP && \
		cp -r $$$$TMP/$(2)/* $(SKILLS_DIR)/$(2)/ && \
		rm -rf $$$$TMP
	@echo "  -> $(SKILLS_DIR)/$(2)"
endef

$(foreach s,$(CLAUDE_SKILLS),$(eval $(call install_skill,$(firstword $(subst @, ,$(s))),$(lastword $(subst @, ,$(s))))))

update-claude-deps: clean-claude-deps install-claude-deps

clean-claude-deps:
	@echo "Removing installed Claude skills..."
	@$(foreach s,$(CLAUDE_SKILLS),rm -rf $(SKILLS_DIR)/$(lastword $(subst @, ,$(s)));)
