#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def _option(arguments: list[str], name: str) -> str:
    return arguments[arguments.index(name) + 1]


arguments = sys.argv[1:]
log_path = Path(os.environ["FAKE_GH_LOG"])
state_path = Path(os.environ["FAKE_GH_STATE"])
state = json.loads(state_path.read_text()) if state_path.exists() else {"issues": []}

with log_path.open("a") as log:
    log.write(json.dumps(arguments, separators=(",", ":")) + "\n")

if arguments[:2] == ["issue", "list"]:
    marker = _option(arguments, "--search")
    matches = [
        {"url": issue["url"], "body": issue["body"]}
        for issue in state["issues"]
        if marker in issue["body"]
    ]
    print(json.dumps(matches, separators=(",", ":")))
    raise SystemExit(0)

if arguments[:2] == ["issue", "create"]:
    fail_after = int(os.environ.get("FAKE_GH_FAIL_AFTER", "0"))
    if fail_after and len(state["issues"]) >= fail_after:
        print("simulated create failure", file=sys.stderr)
        raise SystemExit(1)

    issue = {
        "url": f"https://github.test/example/repo/issues/{len(state['issues']) + 1}",
        "title": _option(arguments, "--title"),
        "body": _option(arguments, "--body"),
        "labels": _option(arguments, "--label").split(","),
    }
    state["issues"].append(issue)
    state_path.write_text(json.dumps(state, indent=2) + "\n")
    print(issue["url"])
    raise SystemExit(0)

if arguments[:2] == ["issue", "edit"]:
    raise SystemExit(0)

print(f"unsupported fake gh invocation: {arguments}", file=sys.stderr)
raise SystemExit(2)
