{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Follow the pack's next release line: `<package>-vX.Y.Z-next` tags (and stable ones) pinned by `ref:` under a `- git: owner/repo/<package>` line in apm.yml.",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pack pin in apm.yml, stable and -next tags",
      "managerFilePatterns": [
        "/(^|/)apm\\.yml$/"
      ],
      "matchStrings": [
        "git:\\s*(?<owner>[\\w.-]+)/(?<repo>[\\w.-]+)/(?<package>[\\w.-]+)[ \\t]*\\r?\\n\\s*ref:\\s*[\\w.-]+-v(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-next)?)[ \\t]*(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{owner}}}/{{{repo}}}",
      "depNameTemplate": "{{{owner}}}/{{{repo}}}/{{{package}}}",
      "extractVersionTemplate": "^{{{package}}}-v(?<version>\\d+\\.\\d+\\.\\d+(?:-next)?)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "A -next tag is the line's release, so it is not an unstable version to skip",
      "matchManagers": [
        "custom.regex"
      ],
      "ignoreUnstable": false,
      "matchFileNames": [
        "**/apm.yml",
        "apm.yml"
      ]
    }
  ]
}
