{
  "baseDir": ".workflow",
  "workIdConvention": "<yyyy-mm-dd>-<slug>",
  "humanArtifactPattern": "NN-NAME.{md,mdx}",
  "underscoreDirs": [
    "_state",
    "_phases",
    "_reviews",
    "_evidence"
  ],
  "stateFile": "_state/state.json",
  "reviewEvidencePattern": "_reviews/<phase>/<reviewer>.md",
  "phases": [
    "spec",
    "tech_design",
    "planning"
  ],
  "gateVerdicts": [
    "pass",
    "needs-rework",
    "needs-user"
  ],
  "reviewersByPhase": {
    "spec": [
      "intent",
      "testability"
    ],
    "tech_design": [
      "reuse-coverage",
      "fit-risk"
    ]
  },
  "reworkCap": 2
}
